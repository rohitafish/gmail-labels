# Direct runtime dependencies, exact pins. This is the file a human edits;
# requirements.txt is GENERATED from it -- with `uv pip compile --universal`,
# not bare pip-compile -- and carries every transitive dependency with sha256
# hashes for every platform, so `pip install --require-hashes -r
# requirements.txt` installs exactly the bytes the suite and CI ran against --
# not whatever an unpinned transitive (there are ~30 behind these two) or a
# tampered release would resolve to that day. --universal matters: a plain
# `pip-compile` (pip-tools) resolves environment markers against the machine
# that ran it and can silently drop a package a different platform needs --
# uv's --universal keeps every platform's resolution branch and hashes it.
# Bump a pin here, then regenerate:
#
#   uv pip compile --universal --generate-hashes -o requirements.txt requirements.in
#
# Dependabot understands this layout and regenerates requirements.txt itself
# in its PRs. See CONTRIBUTING.md's "Dependencies".
google-api-python-client==2.199.0
google-auth-oauthlib==1.4.1
