.pii-denylist

# Dev tooling caches (pytest, ruff, coverage) - see pytest.ini, ruff.toml,
# .coveragerc. Regenerated on every run; nothing here is meant to be shared.
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Claude Code's own local session/config directory - machine-specific,
